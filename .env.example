# TTS (text-to-speech) - backends: omnivoice (default), openai, edge_tts, gemini
TTS_BACKEND=omnivoice
TTS_API_URL=http://localhost:5959
TTS_VOICE=a969b458
# TTS_NUM_STEP=32       # diffusion steps: 16=fast, 32=quality (omnivoice only)
# TTS_SPEED=            # speech rate multiplier, e.g. 1.2 (omnivoice only)

# OpenAI-compatible TTS (used when TTS_BACKEND=openai)
# TTS_API_URL=http://localhost:5959/v1
# TTS_API_KEY=
# TTS_MODEL=omnivoice
LLLLLLLL
# Gemini TTS (used when TTS_BACKEND=gemini)
# GEMINI_API_KEY=
# TTS_GEMINI_VOICE=Kore
# TTS_MODEL=gemini-2.5-flash-preview-tts

# When true, Shift+L will first summarize text via LLM before speaking
# TTS_PRE_SUMMARIZE=false

# Summarization - backends: openai (default, LM Studio), gemini
SUMM_BACKEND=openai
SUMM_API_URL=http://localhost:1234/v1
# SUMM_API_KEY=
SUMM_MODEL=google/gemma-4-26b-a4b

# Gemini summarization (used when SUMM_BACKEND=gemini, shares GEMINI_API_KEY with TTS)
# SUMM_BACKEND=gemini
# SUMM_MODEL=gemini-3-flash-preview
